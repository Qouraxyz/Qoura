# Names only. Copy to .env.local (local) or set in Vercel > Project > Settings > Environment Variables.
# Every variable is optional: without one, the matching feature shows a calm "not configured" state.

# Credit desk (after deploying the contracts; the site runs in practice mode until set)
NEXT_PUBLIC_QOURA_DESK=
NEXT_PUBLIC_QOURA_DESK_BLOCK=

# Gateway: model supplier key (OpenRouter, starts with sk-or-v1-) and a site-wide hourly spend ceiling in USD (default 50)
OPENROUTER_API_KEY=
QOURA_HOURLY_USD_CAP=

# Gasless relayer: a hot wallet private key (0x + 64 hex) holding a little ETH for gas, nothing else
QOURA_RELAYER_KEY=

# Ledger for keys, spend tags and rate limits (one of these; required on Vercel for the gateway)
KV_REDIS_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
STORE_KEY_PREFIX=

# Private RPC (empty = public Robinhood Chain RPC)
ROBINHOOD_RPC_URL=
NEXT_PUBLIC_ROBINHOOD_RPC_URL=

# WalletConnect project id (cloud.reown.com); empty = WalletConnect shown as not configured
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
